# ==============================================================================
# JARVIS Agent Server Environment Variables & API Secrets
# Copy this file to ~/.hermes/.env or .env on your server
# ==============================================================================

# Primary LLM API Keys (At least one is required)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: DeepSeek / OpenRouter / Groq / Ollama
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Optional: Client Radar Inbound Adapters (Telegram, Discord, Slack)
TELEGRAM_BOT_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
DISCORD_BOT_TOKEN=""

# Server Security Token (Optional, leave blank for local or VPN network)
HERMES_GATEWAY_TOKEN=""
